# Copiez ce fichier en `.env.local` et remplissez les valeurs depuis
# votre projet Supabase (Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Repli pour construire les liens envoyés par email. En temps normal l'app
# utilise l'hôte de la requête en cours : laissez vide sauf besoin particulier.
NEXT_PUBLIC_APP_URL=

# Envoi automatique des factures par email (optionnel).
# Sans ces deux variables, l'app bascule sur le partage manuel du lien.
# Clé API : https://resend.com/api-keys
RESEND_API_KEY=
# Expéditeur, sur un domaine vérifié chez Resend.
EMAIL_FROM=
